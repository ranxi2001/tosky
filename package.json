{
  "name": "tosky-nimbus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "check:content": "node scripts/check-content.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:okx-sync": "node --test tests/okx-activity-sync.test.mjs",
    "check": "npm run test:okx-sync && npm run typecheck && npm run lint:docs && npm run check:content && npm run build",
    "new:post": "node scripts/new-post.mjs",
    "sync:okx": "node scripts/sync-okx-activities.mjs",
    "preview:cf": "npm run build && wrangler dev",
    "predeploy": "npm run check",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@cloudflare/nimbus-docs": "0.8.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.1.3",
    "astro-icon": "1.1.5",
    "astro-og-canvas": "0.13.0",
    "canvaskit-wasm": "0.41.1",
    "clsx": "2.1.1",
    "satteri": "0.9.5",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/vite": "4.3.3",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  },
  "packageManager": "npm@10.9.2"
}
