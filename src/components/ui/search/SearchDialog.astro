---
import { Icon } from "astro-icon/components";
import { Dialog, DialogClose, DialogContent } from "@/components/ui/dialog";
---

<Dialog aria-label="搜索站内内容" data-search-dialog>
  <DialogContent class="max-w-xl bg-muted shadow-xl ring-border">
    <div class="overflow-hidden rounded-t-lg bg-card border-b border-border">
      <div class="flex items-center gap-3 border-b border-border px-4 py-3">
        <Icon name="ph:magnifying-glass" class="h-4 w-4 shrink-0 text-muted-foreground" />
        <input
          data-search-input
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          aria-controls="search-listbox"
          type="text"
          placeholder="搜索文章、交易所或链上活动"
          class="min-w-0 flex-1 border-0 bg-transparent text-sm text-foreground placeholder:text-muted-foreground focus:outline-none"
          autocomplete="off"
          spellcheck="false"
          autocorrect="off"
          autocapitalize="none"
        />
        <DialogClose class="grid h-8 w-8 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground" aria-label="关闭搜索" title="关闭">
          <Icon name="ph:x" class="h-4 w-4" />
        </DialogClose>
      </div>

      <div
        data-search-results
        role="listbox"
        id="search-listbox"
        aria-orientation="vertical"
        class="min-h-40 overflow-y-auto p-2"
      >
        <p data-search-empty class="py-8 text-center text-sm text-muted-foreground">
          输入关键词开始搜索
        </p>
      </div>
    </div>

  </DialogContent>
</Dialog>

<script>
  import "./search.client";
</script>
