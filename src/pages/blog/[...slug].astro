---
import { getCollection } from "astro:content";
import {
  getCollectionPageProps,
  getCollectionStaticPaths,
} from "@cloudflare/nimbus-docs";
import type { HeadElement } from "@cloudflare/nimbus-docs/types";
import { config } from "virtual:nimbus/config";
import { components } from "../../components";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import type { BlogPost } from "../../lib/posts";
import { categoryLabels } from "../../lib/posts";

export const prerender = true;
export const getStaticPaths = getCollectionStaticPaths("blog");

const { entry, Content, headings } = await getCollectionPageProps<"blog">(Astro);
const canonicalPath = `/blog/${entry.id}/`;
const canonicalUrl = new URL(canonicalPath, config.site).href;
const markdownPath = `/blog/${entry.id}/index.md`;
const markdownUrl =
  entry.data.noindex || entry.data.draft
    ? undefined
    : new URL(markdownPath, config.site).href;
const socialImage = entry.data.socialImage ?? `/og/blog/${entry.id}.png`;
const socialImageUrl = new URL(socialImage, config.site).href;

const about = [entry.data.exchange, entry.data.chain]
  .filter((value): value is string => Boolean(value))
  .map((name) => ({ "@type": "Thing", name }));
const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  url: canonicalUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  image: socialImageUrl,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  author: { "@type": "Person", name: entry.data.author },
  publisher: { "@type": "Organization", name: config.title, url: config.site },
  inLanguage: config.locale ?? "zh-CN",
  articleSection: categoryLabels[entry.data.category],
  keywords: entry.data.tags.join(", "),
  isAccessibleForFree: true,
  ...(about.length > 0 ? { about } : {}),
  ...(entry.data.sources.length > 0
    ? { citation: entry.data.sources.map((source) => source.url) }
    : {}),
};
const structuredData = JSON.stringify(blogPosting).replace(/</g, "\\u003c");
const head: HeadElement[] = [
  ...entry.data.head,
  {
    tag: "meta",
    attrs: {
      property: "article:published_time",
      content: entry.data.publishedAt.toISOString(),
    },
  },
  {
    tag: "meta",
    attrs: { property: "article:section", content: categoryLabels[entry.data.category] },
  },
  ...entry.data.tags.map((tag) => ({
    tag: "meta" as const,
    attrs: { property: "article:tag", content: tag },
  })),
  {
    tag: "script",
    attrs: { type: "application/ld+json" },
    content: structuredData,
  },
];

const published = await getCollection(
  "blog",
  ({ data }) => !data.draft && !data.noindex,
);
const sourceTags = new Set(entry.data.tags);
const relatedPosts = published
  .filter((candidate) => candidate.id !== entry.id)
  .map((candidate) => {
    const sharedTags = candidate.data.tags.filter((tag) => sourceTags.has(tag)).length;
    const score =
      sharedTags * 3 +
      (candidate.data.category === entry.data.category ? 4 : 0) +
      (candidate.data.exchange && candidate.data.exchange === entry.data.exchange ? 2 : 0) +
      (candidate.data.chain && candidate.data.chain === entry.data.chain ? 2 : 0);
    return { candidate, score };
  })
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.candidate.data.publishedAt.getTime() - a.candidate.data.publishedAt.getTime(),
  )
  .slice(0, 3)
  .map(({ candidate }) => candidate as BlogPost);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  head={head}
  noindex={entry.data.noindex || entry.data.draft}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={entry.data.updatedAt}
  collection={entry.collection}
  entryId={entry.id}
  searchable={entry.data.searchable}
  post={entry}
  headings={headings}
  relatedPosts={relatedPosts}
>
  <Content components={components} />
</ArticleLayout>
