---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PostCard from "@/components/PostCard.astro";
import { categoryLabels, publishedPosts } from "@/lib/posts";

const posts = publishedPosts(await getCollection("blog"));
const categoryCount = new Set(posts.map((post) => post.data.category)).size;
const description = "ToSky 全部 Web3 交易所、链上活动、手续费与返佣规则文章归档。";
---

<BaseLayout title="全部文章" description={description}>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main-content" class="flex-1">
      <header class="border-b border-border bg-card/40">
        <div class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8">
          <p class="text-sm font-medium text-primary">内容归档</p>
          <h1 class="mt-2 text-3xl font-semibold text-foreground">全部文章</h1>
          <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">{description}</p>
          <p class="mt-4 text-sm text-muted-foreground">共 {posts.length} 篇，覆盖 {categoryCount} 个内容分类</p>
        </div>
      </header>

      <section aria-label="文章列表" class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8">
        {posts.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <div class="border-y border-border py-10">
            <h2 class="text-lg font-medium text-foreground">暂无文章</h2>
            <p class="mt-2 text-muted-foreground">发布后的内容会出现在这里。</p>
          </div>
        )}
      </section>

      <aside class="mx-auto mb-10 w-full max-w-6xl px-5 lg:px-8" aria-label="浏览其他归档">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border pt-5 text-sm">
          <span class="text-muted-foreground">继续浏览</span>
          <a href="/activities/" class="font-medium text-foreground no-underline hover:text-primary">活动状态</a>
          <a href="/tag/" class="font-medium text-foreground no-underline hover:text-primary">全部标签</a>
          {Object.entries(categoryLabels).map(([category, label]) => (
            <span class="text-muted-foreground">{label} {posts.filter((post) => post.data.category === category).length}</span>
          ))}
        </div>
      </aside>
    </main>
    <Footer />
  </div>
</BaseLayout>
